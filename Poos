#property strict

#include <Trade/Trade.mqh>
CTrade trade;

//==================== SETTINGS =====================================

input double LotSize = 0.01;

// Pending distance
input int DistancePoints = 100;

// SL / TP
input int StopLossPoints   = 100;
input int TakeProfitPoints = 300;

// Trailing Stop
input bool UseTrailingStop = true;
input int TrailingStopPoints = 100;

//==================== VOLUME FILTER ================================

input bool UseVolumeFilter = true;
input int VolumePeriod = 20;

// Current volume must be greater than
// Average Volume × this multiplier
input double VolumeMultiplier = 1.50;

//==================== BREAKOUT FILTER ==============================

input bool UseBreakoutFilter = true;
input int BreakoutLookback = 10;

//==================== SPREAD FILTER ================================

input bool UseSpreadFilter = true;
input int MaxSpreadPoints = 80;

//==================== MAGIC ========================================

input ulong MagicNumber = 20260819;

//+------------------------------------------------------------------+
//| Count open positions                                             |
//+------------------------------------------------------------------+
int CountOpenPositions()
{
   int count = 0;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(PositionGetString(POSITION_SYMBOL) == _Symbol &&
         (ulong)PositionGetInteger(POSITION_MAGIC) == MagicNumber)
      {
         count++;
      }
   }

   return count;
}

//+------------------------------------------------------------------+
//| Count pending orders                                             |
//+------------------------------------------------------------------+
int CountPendingOrders()
{
   int count = 0;

   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      ulong ticket = OrderGetTicket(i);

      if(ticket == 0)
         continue;

      if(OrderGetString(ORDER_SYMBOL) == _Symbol &&
         (ulong)OrderGetInteger(ORDER_MAGIC) == MagicNumber)
      {
         count++;
      }
   }

   return count;
}

//+------------------------------------------------------------------+
//| Delete pending orders                                            |
//+------------------------------------------------------------------+
void DeletePendingOrders()
{
   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      ulong ticket = OrderGetTicket(i);

      if(ticket == 0)
         continue;

      if(OrderGetString(ORDER_SYMBOL) == _Symbol &&
         (ulong)OrderGetInteger(ORDER_MAGIC) == MagicNumber)
      {
         trade.OrderDelete(ticket);
      }
   }
}

//+------------------------------------------------------------------+
//| Get average tick volume                                         |
//+------------------------------------------------------------------+
double GetAverageVolume()
{
   long volumes[];

   ArraySetAsSeries(volumes, true);

   int copied = CopyTickVolume(
      _Symbol,
      PERIOD_CURRENT,
      1,
      VolumePeriod,
      volumes
   );

   if(copied <= 0)
      return 0;

   double sum = 0;

   for(int i = 0; i < copied; i++)
      sum += (double)volumes[i];

   return sum / copied;
}

//+------------------------------------------------------------------+
//| Volume confirmation                                              |
//+------------------------------------------------------------------+
bool VolumeConfirmed()
{
   if(!UseVolumeFilter)
      return true;

   long currentVolume =
      iVolume(_Symbol, PERIOD_CURRENT, 0);

   double averageVolume =
      GetAverageVolume();

   if(averageVolume <= 0)
      return false;

   double requiredVolume =
      averageVolume * VolumeMultiplier;

   if((double)currentVolume >= requiredVolume)
      return true;

   return false;
}

//+------------------------------------------------------------------+
//| Breakout confirmation                                            |
//+------------------------------------------------------------------+
bool BreakoutConfirmed()
{
   if(!UseBreakoutFilter)
      return true;

   double highest =
      iHigh(_Symbol, PERIOD_CURRENT, 1);

   double lowest =
      iLow(_Symbol, PERIOD_CURRENT, 1);

   for(int i = 2; i <= BreakoutLookback; i++)
   {
      double high =
         iHigh(_Symbol, PERIOD_CURRENT, i);

      double low =
         iLow(_Symbol, PERIOD_CURRENT, i);

      if(high > highest)
         highest = high;

      if(low < lowest)
         lowest = low;
   }

   double ask =
      SymbolInfoDouble(_Symbol, SYMBOL_ASK);

   double bid =
      SymbolInfoDouble(_Symbol, SYMBOL_BID);

   if(ask > highest || bid < lowest)
      return true;

   return false;
}

//+------------------------------------------------------------------+
//| Spread filter                                                     |
//+------------------------------------------------------------------+
bool SpreadOK()
{
   if(!UseSpreadFilter)
      return true;

   double ask =
      SymbolInfoDouble(_Symbol, SYMBOL_ASK);

   double bid =
      SymbolInfoDouble(_Symbol, SYMBOL_BID);

   double spreadPoints =
      (ask - bid) / _Point;

   if(spreadPoints <= MaxSpreadPoints)
      return true;

   return false;
}

//+------------------------------------------------------------------+
//| Place pending orders                                             |
//+------------------------------------------------------------------+
void PlaceBothPendingOrders()
{
   if(!SpreadOK())
   {
      Print("VolumeBreakout: Spread too high.");
      return;
   }

   if(!VolumeConfirmed())
   {
      Print("VolumeBreakout: Volume not confirmed.");
      return;
   }

   if(!BreakoutConfirmed())
   {
      Print("VolumeBreakout: Breakout not confirmed.");
      return;
   }

   DeletePendingOrders();

   double ask =
      SymbolInfoDouble(_Symbol, SYMBOL_ASK);

   double bid =
      SymbolInfoDouble(_Symbol, SYMBOL_BID);

   trade.SetExpertMagicNumber(MagicNumber);
   trade.SetDeviationInPoints(50);

   //===============================================================
   // BUY STOP
   //===============================================================

   double buyPrice =
      NormalizeDouble(
         ask + DistancePoints * _Point,
         _Digits
      );

   double buySL =
      NormalizeDouble(
         buyPrice - StopLossPoints * _Point,
         _Digits
      );

   double buyTP =
      NormalizeDouble(
         buyPrice + TakeProfitPoints * _Point,
         _Digits
      );

   bool buyResult =
      trade.BuyStop(
         LotSize,
         buyPrice,
         _Symbol,
         buySL,
         buyTP,
         ORDER_TIME_GTC,
         0,
         "Volume Breakout BUY"
      );

   if(buyResult)
      Print("BUY STOP placed: ", buyPrice);
   else
      Print("BUY STOP failed: ",
            trade.ResultRetcodeDescription());

   //===============================================================
   // SELL STOP
   //===============================================================

   double sellPrice =
      NormalizeDouble(
         bid - DistancePoints * _Point,
         _Digits
      );

   double sellSL =
      NormalizeDouble(
         sellPrice + StopLossPoints * _Point,
         _Digits
      );

   double sellTP =
      NormalizeDouble(
         sellPrice - TakeProfitPoints * _Point,
         _Digits
      );

   bool sellResult =
      trade.SellStop(
         LotSize,
         sellPrice,
         _Symbol,
         sellSL,
         sellTP,
         ORDER_TIME_GTC,
         0,
         "Volume Breakout SELL"
      );

   if(sellResult)
      Print("SELL STOP placed: ", sellPrice);
   else
      Print("SELL STOP failed: ",
            trade.ResultRetcodeDescription());
}

//+------------------------------------------------------------------+
//| Trailing Stop                                                     |
//+------------------------------------------------------------------+
void ApplyTrailingStop()
{
   if(!UseTrailingStop)
      return;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(PositionGetString(POSITION_SYMBOL) != _Symbol)
         continue;

      if((ulong)PositionGetInteger(POSITION_MAGIC)
         != MagicNumber)
         continue;

      long type =
         PositionGetInteger(POSITION_TYPE);

      double currentSL =
         PositionGetDouble(POSITION_SL);

      double currentTP =
         PositionGetDouble(POSITION_TP);

      double openPrice =
         PositionGetDouble(POSITION_PRICE_OPEN);

      //============================================================
      // BUY
      //============================================================

      if(type == POSITION_TYPE_BUY)
      {
         double bid =
            SymbolInfoDouble(_Symbol, SYMBOL_BID);

         if(bid - openPrice >
            TrailingStopPoints * _Point)
         {
            double newSL =
               NormalizeDouble(
                  bid - TrailingStopPoints * _Point,
                  _Digits
               );

            if(newSL > currentSL || currentSL == 0)
            {
               trade.PositionModify(
                  ticket,
                  newSL,
                  currentTP
               );
            }
         }
      }

      //============================================================
      // SELL
      //============================================================

      if(type == POSITION_TYPE_SELL)
      {
         double ask =
            SymbolInfoDouble(_Symbol, SYMBOL_ASK);

         if(openPrice - ask >
            TrailingStopPoints * _Point)
         {
            double newSL =
               NormalizeDouble(
                  ask + TrailingStopPoints * _Point,
                  _Digits
               );

            if(newSL < currentSL || currentSL == 0)
            {
               trade.PositionModify(
                  ticket,
                  newSL,
                  currentTP
               );
            }
         }
      }
   }
}

//+------------------------------------------------------------------+
//| Expert initialization                                            |
//+------------------------------------------------------------------+
int OnInit()
{
   trade.SetExpertMagicNumber(MagicNumber);

   Print("====================================");
   Print("XAUUSD VOLUME BREAKOUT V2");
   Print("Volume Period: ", VolumePeriod);
   Print("Volume Multiplier: ", VolumeMultiplier);
   Print("Breakout Lookback: ", BreakoutLookback);
   Print("Max Spread: ", MaxSpreadPoints);
   Print("====================================");

   return(INIT_SUCCEEDED);
}

//+------------------------------------------------------------------+
//| Main                                                             |
//+------------------------------------------------------------------+
void OnTick()
{
   // 1. Trailing
   ApplyTrailingStop();

   int openPositions =
      CountOpenPositions();

   int pendingOrders =
      CountPendingOrders();

   //===============================================================
   // If trade opened -> delete opposite pending
   //===============================================================

   if(openPositions > 0 && pendingOrders > 0)
   {
      DeletePendingOrders();
      return;
   }

   //===============================================================
   // No trade + no pending -> look for setup
   //===============================================================

   if(openPositions == 0 &&
      pendingOrders == 0)
   {
      PlaceBothPendingOrders();
   }
}
