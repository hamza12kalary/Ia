#property strict

#include <Trade/Trade.mqh>
CTrade trade;

//==================== SETTINGS =====================================

input double LotSize          = 0.01;

// Pending distance
input int DistancePoints      = 100;

// SL / TP
input int StopLossPoints      = 100;
input int TakeProfitPoints    = 300;

// Trailing Stop
input bool UseTrailingStop    = true;
input int TrailingStopPoints  = 100;

//==================== VOLUME FILTER ================================

input bool UseVolumeFilter    = true;
input int VolumePeriod        = 20;

// Current volume must be greater than Average Volume * VolumeMultiplier
input double VolumeMultiplier = 1.50;

//==================== BREAKOUT FILTER ==============================

input bool UseBreakoutFilter  = true;
input int BreakoutLookback    = 10;

//==================== SPREAD FILTER ================================

input bool UseSpreadFilter    = true;
input int MaxSpreadPoints     = 80;

//==================== MAGIC ========================================

input ulong MagicNumber       = 20260819;

//+------------------------------------------------------------------+
//| Count open positions                                             |
//+------------------------------------------------------------------+
int CountOpenPositions()
{
   int count = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(ticket == 0) continue;

      if(PositionGetString(POSITION_SYMBOL) == _Symbol &&
         (ulong)PositionGetInteger(POSITION_MAGIC) == MagicNumber)
      {
         count++;
      }
   }
   return count;
}

//+------------------------------------------------------------------+
//| Count pending orders                                             |
//+------------------------------------------------------------------+
int CountPendingOrders()
{
   int count = 0;
   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      ulong ticket = OrderGetTicket(i);
      if(ticket == 0) continue;

      if(OrderGetString(ORDER_SYMBOL) == _Symbol &&
         (ulong)OrderGetInteger(ORDER_MAGIC) == MagicNumber)
      {
         count++;
      }
   }
   return count;
}

//+------------------------------------------------------------------+
//| Delete pending orders                                            |
//+------------------------------------------------------------------+
void DeletePendingOrders()
{
   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      ulong ticket = OrderGetTicket(i);
      if(ticket == 0) continue;

      if(OrderGetString(ORDER_SYMBOL) == _Symbol &&
         (ulong)OrderGetInteger(ORDER_MAGIC) == MagicNumber)
      {
         trade.OrderDelete(ticket);
      }
   }
}

//+------------------------------------------------------------------+
//| Get average tick volume                                         |
//+------------------------------------------------------------------+
double GetAverageVolume()
{
   long volumes[];
   ArraySetAsSeries(volumes, true);

   int copied = CopyTickVolume(_Symbol, PERIOD_CURRENT, 1, VolumePeriod, volumes);

   if(copied <= 0) return 0;

   double sum = 0;
   for(int i = 0; i < copied; i++)
      sum += (double)volumes[i];

   return sum / copied;
}

//+------------------------------------------------------------------+
//| Volume confirmation                                              |
//+------------------------------------------------------------------+
bool VolumeConfirmed()
{
   if(!UseVolumeFilter) return true;

   long volumes[];
   ArraySetAsSeries(volumes, true);
   if(CopyTickVolume(_Symbol, PERIOD_CURRENT, 0, 1, volumes) <= 0)
      return false;

   long currentVolume = volumes[0];
   double averageVolume = GetAverageVolume();

   if(averageVolume <= 0) return false;

   return ((double)currentVolume >= (averageVolume * VolumeMultiplier));
}

//+------------------------------------------------------------------+
//| Breakout confirmation                                            |
//+------------------------------------------------------------------+
bool BreakoutConfirmed()
{
   if(!UseBreakoutFilter) return true;

   double highs[], lows[];
   ArraySetAsSeries(highs, true);
   ArraySetAsSeries(lows, true);

   if(CopyHigh(_Symbol, PERIOD_CURRENT, 1, BreakoutLookback, highs) <= 0) return false;
   if(CopyLow(_Symbol, PERIOD_CURRENT, 1, BreakoutLookback, lows) <= 0) return false;

   double highest = highs[0];
   double lowest = lows[0];

   for(int i = 1; i < BreakoutLookback; i++)
   {
      if(highs[i] > highest) highest = highs[i];
      if(lows[i] < lowest) lowest = lows[i];
   }

   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);

   // ئەگەر نرخ لە نزیک یان دەرەوەی بەرزترین/نزمترین ئاستی ڕابردوو بێت
   if(ask >= highest || bid <= lowest)
      return true;

   return false;
}

//+------------------------------------------------------------------+
//| Spread filter                                                     |
//+------------------------------------------------------------------+
bool SpreadOK()
{
   if(!UseSpreadFilter) return true;

   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);

   double spreadPoints = (ask - bid) / _Point;

   return (spreadPoints <= MaxSpreadPoints);
}

//+------------------------------------------------------------------+
//| Place pending orders                                             |
//+------------------------------------------------------------------+
void PlaceBothPendingOrders()
{
   if(!SpreadOK()) return;
   if(!VolumeConfirmed()) return;
   if(!BreakoutConfirmed()) return;

   DeletePendingOrders();

   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);

   trade.SetExpertMagicNumber(MagicNumber);
   trade.SetDeviationInPoints(50);

   // BUY STOP
   double buyPrice = NormalizeDouble(ask + DistancePoints * _Point, _Digits);
   double buySL    = NormalizeDouble(buyPrice - StopLossPoints * _Point, _Digits);
   double buyTP    = NormalizeDouble(buyPrice + TakeProfitPoints * _Point, _Digits);

   trade.BuyStop(LotSize, buyPrice, _Symbol, buySL, buyTP, ORDER_TIME_GTC, 0, "Volume Breakout BUY");

   // SELL STOP
   double sellPrice = NormalizeDouble(bid - DistancePoints * _Point, _Digits);
   double sellSL    = NormalizeDouble(sellPrice + StopLossPoints * _Point, _Digits);
   double sellTP    = NormalizeDouble(sellPrice - TakeProfitPoints * _Point, _Digits);

   trade.SellStop(LotSize, sellPrice, _Symbol, sellSL, sellTP, ORDER_TIME_GTC, 0, "Volume Breakout SELL");
}

//+------------------------------------------------------------------+
//| Trailing Stop                                                     |
//+------------------------------------------------------------------+
void ApplyTrailingStop()
{
   if(!UseTrailingStop) return;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(ticket == 0) continue;

      if(PositionGetString(POSITION_SYMBOL) != _Symbol) continue;
      if((ulong)PositionGetInteger(POSITION_MAGIC) != MagicNumber) continue;

      long type        = PositionGetInteger(POSITION_TYPE);
      double currentSL = PositionGetDouble(POSITION_SL);
      double currentTP = PositionGetDouble(POSITION_TP);
      double openPrice = PositionGetDouble(POSITION_PRICE_OPEN);

      if(type == POSITION_TYPE_BUY)
      {
         double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
         if(bid - openPrice > TrailingStopPoints * _Point)
         {
            double newSL = NormalizeDouble(bid - TrailingStopPoints * _Point, _Digits);
            if(newSL > currentSL || currentSL == 0)
            {
               trade.PositionModify(ticket, newSL, currentTP);
            }
         }
      }

      if(type == POSITION_TYPE_SELL)
      {
         double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
         if(openPrice - ask > TrailingStopPoints * _Point)
         {
            double newSL = NormalizeDouble(ask + TrailingStopPoints * _Point, _Digits);
            if(newSL < currentSL || currentSL == 0)
            {
               trade.PositionModify(ticket, newSL, currentTP);
            }
         }
      }
   }
}

//+------------------------------------------------------------------+
//| Expert initialization                                            |
//+------------------------------------------------------------------+
int OnInit()
{
   trade.SetExpertMagicNumber(MagicNumber);
   return(INIT_SUCCEEDED);
}

//+------------------------------------------------------------------+
//| Main                                                             |
//+------------------------------------------------------------------+
void OnTick()
{
   ApplyTrailingStop();

   int openPositions = CountOpenPositions();
   int pendingOrders = CountPendingOrders();

   if(openPositions > 0 && pendingOrders > 0)
   {
      DeletePendingOrders();
      return;
   }

   if(openPositions == 0 && pendingOrders == 0)
   {
      PlaceBothPendingOrders();
   }
}
