//+------------------------------------------------------------------+
//| XAUUSD_Pullback_Confirmation_EA.mq5                              |
//| MT5 Expert Advisor                                               |
//+------------------------------------------------------------------+
#property strict

#include <Trade/Trade.mqh>

CTrade trade;

//========================= INPUTS ===================================

input string TradeSymbol = "XAUUSD";

input ENUM_TIMEFRAMES EntryTF = PERIOD_M1;
input ENUM_TIMEFRAMES ConfirmTF = PERIOD_M5;

input double RiskPercent = 1.0;
input double RiskReward  = 2.0;

input int LookbackBars = 30;

// Pullback zone
input double ZonePercent = 0.382;

// Confirmation
input bool UseEngulfing       = true;
input bool UseBreakOfStructure = true;

// Trend
input int FastEMA = 20;
input int SlowEMA = 50;

// ATR
input int ATRPeriod = 14;
input double ATR_SL_Multiplier = 1.5;

// Spread
input bool UseSpreadFilter = true;
input double MaxSpreadPoints = 80;

// Trading
input bool AllowBuy  = true;
input bool AllowSell = true;

input bool OnePositionOnly = true;

input ulong MagicNumber = 20260825;

//========================= GLOBALS ==================================

int fastEMAHandle;
int slowEMAHandle;
int atrHandle;

datetime lastBarTime = 0;

//+------------------------------------------------------------------+
//| Expert initialization                                            |
//+------------------------------------------------------------------+
int OnInit()
{
   trade.SetExpertMagicNumber(MagicNumber);
   trade.SetDeviationInPoints(30);

   fastEMAHandle = iMA(
      TradeSymbol,
      EntryTF,
      FastEMA,
      0,
      MODE_EMA,
      PRICE_CLOSE
   );

   slowEMAHandle = iMA(
      TradeSymbol,
      EntryTF,
      SlowEMA,
      0,
      MODE_EMA,
      PRICE_CLOSE
   );

   atrHandle = iATR(
      TradeSymbol,
      EntryTF,
      ATRPeriod
   );

   if(fastEMAHandle == INVALID_HANDLE ||
      slowEMAHandle == INVALID_HANDLE ||
      atrHandle == INVALID_HANDLE)
   {
      Print("Indicator initialization failed.");
      return INIT_FAILED;
   }

   Print("======================================");
   Print(" XAUUSD PULLBACK EA STARTED");
   Print(" TF: ", EnumToString(EntryTF));
   Print(" Risk: ", RiskPercent, "%");
   Print(" RR: 1:", RiskReward);
   Print("======================================");

   return INIT_SUCCEEDED;
}

//+------------------------------------------------------------------+
//| Expert deinitialization                                          |
//+------------------------------------------------------------------+
void OnDeinit(const int reason)
{
   IndicatorRelease(fastEMAHandle);
   IndicatorRelease(slowEMAHandle);
   IndicatorRelease(atrHandle);
}

//+------------------------------------------------------------------+
//| Expert tick                                                      |
//+------------------------------------------------------------------+
void OnTick()
{
   if(!SymbolSelect(TradeSymbol, true))
      return;

   // Only process new candle
   datetime currentBar =
      iTime(TradeSymbol, EntryTF, 0);

   if(currentBar == lastBarTime)
      return;

   lastBarTime = currentBar;

   // Spread filter
   if(UseSpreadFilter)
   {
      double ask = SymbolInfoDouble(
         TradeSymbol,
         SYMBOL_ASK
      );

      double bid = SymbolInfoDouble(
         TradeSymbol,
         SYMBOL_BID
      );

      double spreadPoints =
         (ask - bid) /
         SymbolInfoDouble(
            TradeSymbol,
            SYMBOL_POINT
         );

      if(spreadPoints > MaxSpreadPoints)
      {
         Print("Spread too high: ", spreadPoints);
         return;
      }
   }

   // One position only
   if(OnePositionOnly)
   {
      if(HasOurPosition())
         return;
   }

   // Analyze market
   int signal = GetSignal();

   if(signal == 1 && AllowBuy)
   {
      OpenBuy();
   }
   else if(signal == -1 && AllowSell)
   {
      OpenSell();
   }
}

//+------------------------------------------------------------------+
//| SIGNAL                                                           |
//|  1 = BUY                                                         |
//| -1 = SELL                                                        |
//|  0 = NONE                                                        |
//+------------------------------------------------------------------+
int GetSignal()
{
   double fastEMA[];
   double slowEMA[];
   double atr[];

   ArraySetAsSeries(fastEMA, true);
   ArraySetAsSeries(slowEMA, true);
   ArraySetAsSeries(atr, true);

   if(CopyBuffer(
      fastEMAHandle,
      0,
      0,
      5,
      fastEMA
   ) < 5)
      return 0;

   if(CopyBuffer(
      slowEMAHandle,
      0,
      0,
      5,
      slowEMA
   ) < 5)
      return 0;

   if(CopyBuffer(
      atrHandle,
      0,
      0,
      5,
      atr
   ) < 5)
      return 0;

   double close1 =
      iClose(
         TradeSymbol,
         EntryTF,
         1
      );

   double close2 =
      iClose(
         TradeSymbol,
         EntryTF,
         2
      );

   //===============================================================
   // BULLISH TREND
   //===============================================================

   bool bullishTrend =
      fastEMA[1] > slowEMA[1];

   //===============================================================
   // BEARISH TREND
   //===============================================================

   bool bearishTrend =
      fastEMA[1] < slowEMA[1];

   //===============================================================
   // BUY CONFIRMATION
   //===============================================================

   bool bullishConfirmation = false;

   if(UseEngulfing)
   {
      if(IsBullishEngulfing())
         bullishConfirmation = true;
   }

   if(UseBreakOfStructure)
   {
      if(BullishBreakOfStructure())
         bullishConfirmation = true;
   }

   //===============================================================
   // SELL CONFIRMATION
   //===============================================================

   bool bearishConfirmation = false;

   if(UseEngulfing)
   {
      if(IsBearishEngulfing())
         bearishConfirmation = true;
   }

   if(UseBreakOfStructure)
   {
      if(BearishBreakOfStructure())
         bearishConfirmation = true;
   }

   //===============================================================
   // BUY
   //===============================================================

   if(bullishTrend &&
      close1 > close2 &&
      bullishConfirmation)
   {
      Print("BUY SIGNAL DETECTED");
      return 1;
   }

   //===============================================================
   // SELL
   //===============================================================

   if(bearishTrend &&
      close1 < close2 &&
      bearishConfirmation)
   {
      Print("SELL SIGNAL DETECTED");
      return -1;
   }

   return 0;
}

//+------------------------------------------------------------------+
//| Bullish Engulfing                                                |
//+------------------------------------------------------------------+
bool IsBullishEngulfing()
{
   double open1 =
      iOpen(
         TradeSymbol,
         EntryTF,
         1
      );

   double close1 =
      iClose(
         TradeSymbol,
         EntryTF,
         1
      );

   double open2 =
      iOpen(
         TradeSymbol,
         EntryTF,
         2
      );

   double close2 =
      iClose(
         TradeSymbol,
         EntryTF,
         2
      );

   bool previousBear =
      close2 < open2;

   bool currentBull =
      close1 > open1;

   bool engulf =
      open1 <= close2 &&
      close1 >= open2;

   return (
      previousBear &&
      currentBull &&
      engulf
   );
}

//+------------------------------------------------------------------+
//| Bearish Engulfing                                                |
//+------------------------------------------------------------------+
bool IsBearishEngulfing()
{
   double open1 =
      iOpen(
         TradeSymbol,
         EntryTF,
         1
      );

   double close1 =
      iClose(
         TradeSymbol,
         EntryTF,
         1
      );

   double open2 =
      iOpen(
         TradeSymbol,
         EntryTF,
         2
      );

   double close2 =
      iClose(
         TradeSymbol,
         EntryTF,
         2
      );

   bool previousBull =
      close2 > open2;

   bool currentBear =
      close1 < open1;

   bool engulf =
      open1 >= close2 &&
      close1 <= open2;

   return (
      previousBull &&
      currentBear &&
      engulf
   );
}

//+------------------------------------------------------------------+
//| Bullish Break Of Structure                                      |
//+------------------------------------------------------------------+
bool BullishBreakOfStructure()
{
   double previousHigh = 0;

   for(int i = 3; i < LookbackBars + 3; i++)
   {
      double high =
         iHigh(
            TradeSymbol,
            EntryTF,
            i
         );

      if(high > previousHigh)
         previousHigh = high;
   }

   double close1 =
      iClose(
         TradeSymbol,
         EntryTF,
         1
      );

   return close1 > previousHigh;
}

//+------------------------------------------------------------------+
//| Bearish Break Of Structure                                      |
//+------------------------------------------------------------------+
bool BearishBreakOfStructure()
{
   double previousLow = DBL_MAX;

   for(int i = 3; i < LookbackBars + 3; i++)
   {
      double low =
         iLow(
            TradeSymbol,
            EntryTF,
            i
         );

      if(low < previousLow)
         previousLow = low;
   }

   double close1 =
      iClose(
         TradeSymbol,
         EntryTF,
         1
      );

   return close1 < previousLow;
}

//+------------------------------------------------------------------+
//| OPEN BUY                                                         |
//+------------------------------------------------------------------+
void OpenBuy()
{
   double ask =
      SymbolInfoDouble(
         TradeSymbol,
         SYMBOL_ASK
      );

   double atr = GetATR();

   if(atr <= 0)
      return;

   double slDistance =
      atr * ATR_SL_Multiplier;

   double sl =
      ask - slDistance;

   double tp =
      ask + (
         slDistance *
         RiskReward
      );

   NormalizeStops(
      ORDER_TYPE_BUY,
      ask,
      sl,
      tp
   );

   double lot =
      CalculateLotSize(
         ask,
         sl
      );

   if(lot <= 0)
      return;

   bool result =
      trade.Buy(
         lot,
         TradeSymbol,
         ask,
         sl,
         tp,
         "XAUUSD Pullback BUY"
      );

   if(result)
   {
      Print(
         "BUY OPENED | Lot=",
         lot,
         " Entry=",
         ask,
         " SL=",
         sl,
         " TP=",
         tp
      );
   }
   else
   {
      Print(
         "BUY FAILED: ",
         trade.ResultRetcodeDescription()
      );
   }
}

//+------------------------------------------------------------------+
//| OPEN SELL                                                        |
//+------------------------------------------------------------------+
void OpenSell()
{
   double bid =
      SymbolInfoDouble(
         TradeSymbol,
         SYMBOL_BID
      );

   double atr = GetATR();

   if(atr <= 0)
      return;

   double slDistance =
      atr * ATR_SL_Multiplier;

   double sl =
      bid + slDistance;
