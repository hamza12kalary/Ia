#property strict

#include <Trade/Trade.mqh>
CTrade trade;

//==================== INPUT SETTINGS ===============================

input double LotSize          = 0.01;  // لۆت
input int    FixedStopPts     = 100;   // دووری ستۆپی جێگیر لە زەرەردا (100 points = 10 Pips)
input int    ProfitDistancePts= 10;    // دووری تراپ لە قازانجدا (10 points = 1 Pip)
input ulong  MagicNumber      = 111222;

//+------------------------------------------------------------------+
int CountOpenPositions()
{
   int count = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(ticket > 0 && PositionGetString(POSITION_SYMBOL) == _Symbol && (ulong)PositionGetInteger(POSITION_MAGIC) == MagicNumber)
         count++;
   }
   return count;
}

int CountPendingOrders()
{
   int count = 0;
   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      ulong ticket = OrderGetTicket(i);
      if(ticket > 0 && OrderGetString(ORDER_SYMBOL) == _Symbol && (ulong)OrderGetInteger(ORDER_MAGIC) == MagicNumber)
         count++;
   }
   return count;
}

void CloseAndCleanAll()
{
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(ticket > 0 && PositionGetString(POSITION_SYMBOL) == _Symbol && (ulong)PositionGetInteger(POSITION_MAGIC) == MagicNumber)
      {
         trade.PositionClose(ticket);
      }
   }
   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      ulong ticket = OrderGetTicket(i);
      if(ticket > 0 && OrderGetString(ORDER_SYMBOL) == _Symbol && (ulong)OrderGetInteger(ORDER_MAGIC) == MagicNumber)
      {
         trade.OrderDelete(ticket);
      }
   }
}

//+------------------------------------------------------------------+
// وەرگرتنی زانیاری قازانج/زەرەری پۆزیشنی کراوە
//+------------------------------------------------------------------+
double GetCurrentPositionProfit()
{
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(ticket > 0 && PositionGetString(POSITION_SYMBOL) == _Symbol && (ulong)PositionGetInteger(POSITION_MAGIC) == MagicNumber)
      {
         return PositionGetDouble(POSITION_PROFIT);
      }
   }
   return 0.0;
}

//+------------------------------------------------------------------+
// بەڕێوەبردنی ئۆردەری هەڵپەسێردراو (تەنها کاتێک لە قازانجدایە دەجوڵێت)
//+------------------------------------------------------------------+
void ManagePendingOrder()
{
   double profit = GetCurrentPositionProfit();

   // کاتێک لە زەرەردایە ➔ ستۆپەکە لە دووری ١٠ پیپ جێگیر دەمێنێتەوە و ناجوڵێت
   if(profit <= 0) return;

   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);

   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      ulong ticket = OrderGetTicket(i);
      if(ticket > 0 && OrderGetString(ORDER_SYMBOL) == _Symbol && (ulong)OrderGetInteger(ORDER_MAGIC) == MagicNumber)
      {
         long type         = OrderGetInteger(ORDER_TYPE);
         double openPrice = OrderGetDouble(ORDER_PRICE_OPEN);

         // کاتێک لە قازانجدایە، ئۆردەرەکە دێنێتە ۱ پیپی (10 Points) پشتی نرخەکە
         if(type == ORDER_TYPE_SELL_STOP)
         {
            double targetPrice = NormalizeDouble(bid - (ProfitDistancePts * _Point), _Digits);
            if(targetPrice > openPrice)
            {
               trade.OrderModify(ticket, targetPrice, 0, 0, ORDER_TIME_GTC, 0);
            }
         }
         else if(type == ORDER_TYPE_BUY_STOP)
         {
            double targetPrice = NormalizeDouble(ask + (ProfitDistancePts * _Point), _Digits);
            if(targetPrice < openPrice)
            {
               trade.OrderModify(ticket, targetPrice, 0, 0, ORDER_TIME_GTC, 0);
            }
         }
      }
   }
}

//+------------------------------------------------------------------+
// دۆزینەوەی ئاڕاستەی بازار بەپێی Volume و مۆمی پێشوو
//+------------------------------------------------------------------+
int GetVolumeDirection()
{
   double open1  = iOpen(_Symbol, _Period, 1);
   double close1 = iClose(_Symbol, _Period, 1);

   if(close1 > open1)
      return 1;  // BUY
   else if(close1 < open1)
      return -1; // SELL
      
   return 0;
}

//+------------------------------------------------------------------+
// Main EA Logic
//+------------------------------------------------------------------+
void ExecuteLogic()
{
   trade.SetExpertMagicNumber(MagicNumber);
   trade.SetDeviationInPoints(20);

   int openPositions = CountOpenPositions();
   int pendingOrders = CountPendingOrders();

   // 1. کاتێک نرخەکە لە Pending Orderی دا و بووە 2 پۆزیشن ➔ ڕاستەوخۆ هەردووکیان دابخە
   if(openPositions >= 2)
   {
      CloseAndCleanAll();
      return;
   }

   // 2. کاتێک هیچ پۆزیشنێک نییە ➔ بەپێی Volume و ئاڕاستەی مۆمی ۱ ئۆردەر دەکاتەوە
   if(openPositions == 0)
   {
      CloseAndCleanAll();

      double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
      double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
      int direction = GetVolumeDirection();

      if(direction == 1) // BUY logic
      {
         if(trade.Buy(LotSize, _Symbol, ask, 0, 0, "Volume Buy"))
         {
            double sellPrice = NormalizeDouble(bid - (FixedStopPts * _Point), _Digits);
            trade.SellStop(LotSize, sellPrice, _Symbol, 0, 0, ORDER_TIME_GTC, 0, "Protection SellStop");
         }
      }
      else if(direction == -1) // SELL logic
      {
         if(trade.Sell(LotSize, _Symbol, bid, 0, 0, "Volume Sell"))
         {
            double buyPrice = NormalizeDouble(ask + (FixedStopPts * _Point), _Digits);
            trade.BuyStop(LotSize, buyPrice, _Symbol, 0, 0, ORDER_TIME_GTC, 0, "Protection BuyStop");
         }
      }
   }
   // 3. کاتێک ۱ پۆزیشن کراوەیە
   else if(openPositions == 1)
   {
      if(pendingOrders == 0)
      {
         for(int i = PositionsTotal() - 1; i >= 0; i--)
         {
            ulong ticket = PositionGetTicket(i);
            if(ticket > 0 && PositionGetString(POSITION_SYMBOL) == _Symbol && (ulong)PositionGetInteger(POSITION_MAGIC) == MagicNumber)
            {
               long type = PositionGetInteger(POSITION_TYPE);
               double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
               double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);

               if(type == POSITION_TYPE_BUY)
               {
                  double sellPrice = NormalizeDouble(bid - (FixedStopPts * _Point), _Digits);
                  trade.SellStop(LotSize, sellPrice, _Symbol, 0, 0, ORDER_TIME_GTC, 0, "Protection SellStop");
               }
               else if(type == POSITION_TYPE_SELL)
               {
                  double buyPrice = NormalizeDouble(ask + (FixedStopPts * _Point), _Digits);
                  trade.BuyStop(LotSize, buyPrice, _Symbol, 0, 0, ORDER_TIME_GTC, 0, "Protection BuyStop");
               }
               break;
            }
         }
      }
      else
      {
         ManagePendingOrder(); // بەڕێوەبردنی تراپ لە قازانج و زەرەردا
      }
   }
}

//+------------------------------------------------------------------+
int OnInit()
{
   trade.SetExpertMagicNumber(MagicNumber);
   return(INIT_SUCCEEDED);
}

//+------------------------------------------------------------------+
void OnTick()
{
   ExecuteLogic();
}
