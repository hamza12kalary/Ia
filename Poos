#property strict

#include <Trade/Trade.mqh>

CTrade trade;

//==================== SETTINGS =====================================

input double LotSize          = 0.01;

input int DistancePoints      = 100;

input int StopLossPoints      = 100;
input int TakeProfitPoints    = 300;

input bool UseTrailingStop    = true;
input int TrailingStopPoints  = 100;

//==================== VOLUME FILTER ================================

input bool   UseVolumeFilter  = true;
input int    VolumePeriod     = 20;
input double VolumeMultiplier = 1.50;

//==================== BREAKOUT FILTER ==============================

input bool UseBreakoutFilter  = true;
input int  BreakoutLookback   = 10;

//==================== SPREAD FILTER ================================

input bool UseSpreadFilter    = true;
input int  MaxSpreadPoints    = 80;

//==================== MAGIC ========================================

input ulong MagicNumber       = 20260819;

//+------------------------------------------------------------------+
//| Count positions                                                  |
//+------------------------------------------------------------------+
int CountOpenPositions()
{
   int count = 0;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(ticket == 0)
         continue;

      if(PositionGetString(POSITION_SYMBOL) != _Symbol)
         continue;

      if((ulong)PositionGetInteger(POSITION_MAGIC) != MagicNumber)
         continue;

      count++;
   }

   return count;
}

//+------------------------------------------------------------------+
//| Count pending                                                    |
//+------------------------------------------------------------------+
int CountPendingOrders()
{
   int count = 0;

   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      ulong ticket = OrderGetTicket(i);
      if(ticket == 0)
         continue;

      if(OrderGetString(ORDER_SYMBOL) != _Symbol)
         continue;

      if((ulong)OrderGetInteger(ORDER_MAGIC) != MagicNumber)
         continue;

      ENUM_ORDER_TYPE type =
         (ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE);

      if(type == ORDER_TYPE_BUY_STOP ||
         type == ORDER_TYPE_SELL_STOP)
      {
         count++;
      }
   }

   return count;
}

//+------------------------------------------------------------------+
//| Delete ALL old pending orders                                    |
//+------------------------------------------------------------------+
void DeletePendingOrders()
{
   for(int i = OrdersTotal() - 1; i >= 0; i--)
   {
      ulong ticket = OrderGetTicket(i);
      if(ticket == 0)
         continue;

      if(OrderGetString(ORDER_SYMBOL) != _Symbol)
         continue;

      if((ulong)OrderGetInteger(ORDER_MAGIC) != MagicNumber)
         continue;

      ENUM_ORDER_TYPE type =
         (ENUM_ORDER_TYPE)OrderGetInteger(ORDER_TYPE);

      if(type != ORDER_TYPE_BUY_STOP &&
         type != ORDER_TYPE_SELL_STOP)
      {
         continue;
      }

      if(trade.OrderDelete(ticket))
      {
         Print("Old pending deleted #", ticket);
      }
      else
      {
         Print(
            "Delete failed #",
            ticket,
            " | ",
            trade.ResultRetcodeDescription()
         );
      }
   }
}

//+------------------------------------------------------------------+
//| Average volume                                                   |
//+------------------------------------------------------------------+
double GetAverageVolume()
{
   long volumes[];

   ArraySetAsSeries(volumes, true);

   int copied = CopyTickVolume(
      _Symbol,
      PERIOD_CURRENT,
      1,
      VolumePeriod,
      volumes
   );

   if(copied <= 0)
      return 0;

   double sum = 0;

   for(int i = 0; i < copied; i++)
      sum += (double)volumes[i];

   return sum / copied;
}

//+------------------------------------------------------------------+
//| Volume confirmation                                              |
//+------------------------------------------------------------------+
bool VolumeConfirmed()
{
   if(!UseVolumeFilter)
      return true;

   long volumes[];

   ArraySetAsSeries(volumes, true);

   if(CopyTickVolume(
      _Symbol,
      PERIOD_CURRENT,
      0,
      1,
      volumes
   ) <= 0)
   {
      return false;
   }

   double currentVolume = (double)volumes[0];

   double averageVolume =
      GetAverageVolume();

   if(averageVolume <= 0)
      return false;

   return(
      currentVolume >=
      averageVolume * VolumeMultiplier
   );
}

//+------------------------------------------------------------------+
//| Breakout confirmation                                            |
//+------------------------------------------------------------------+
bool BreakoutConfirmed()
{
   if(!UseBreakoutFilter)
      return true;

   double highs[];
   double lows[];

   ArraySetAsSeries(highs, true);
   ArraySetAsSeries(lows, true);

   if(CopyHigh(
      _Symbol,
      PERIOD_CURRENT,
      1,
      BreakoutLookback,
      highs
   ) <= 0)
   {
      return false;
   }

   if(CopyLow(
      _Symbol,
      PERIOD_CURRENT,
      1,
      BreakoutLookback,
      lows
   ) <= 0)
   {
      return false;
   }

   double highest = highs[0];
   double lowest  = lows[0];

   for(int i = 1; i < BreakoutLookback; i++)
   {
      if(highs[i] > highest)
         highest = highs[i];

      if(lows[i] < lowest)
         lowest = lows[i];
   }

   double ask =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_ASK
      );

   double bid =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_BID
      );

   if(ask >= highest || bid <= lowest)
      return true;

   return false;
}

//+------------------------------------------------------------------+
//| Spread filter                                                    |
//+------------------------------------------------------------------+
bool SpreadOK()
{
   if(!UseSpreadFilter)
      return true;

   double ask =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_ASK
      );

   double bid =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_BID
      );

   double spread =
      (ask - bid) / _Point;

   return(spread <= MaxSpreadPoints);
}

//+------------------------------------------------------------------+
//| Place BUY STOP                                                   |
//+------------------------------------------------------------------+
bool PlaceBuyStop()
{
   if(!SpreadOK())
      return false;

   double ask =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_ASK
      );

   double price =
      NormalizeDouble(
         ask + DistancePoints * _Point,
         _Digits
      );

   double sl =
      NormalizeDouble(
         price - StopLossPoints * _Point,
         _Digits
      );

   double tp =
      NormalizeDouble(
         price + TakeProfitPoints * _Point,
         _Digits
      );

   trade.SetExpertMagicNumber(MagicNumber);
   trade.SetDeviationInPoints(50);

   bool result =
      trade.BuyStop(
         LotSize,
         price,
         _Symbol,
         sl,
         tp,
         ORDER_TIME_GTC,
         0,
         "REFRESH BUY STOP"
      );

   if(result)
   {
      Print(
         "NEW BUY STOP @ ",
         DoubleToString(price, _Digits)
      );
   }
   else
   {
      Print(
         "BUY STOP ERROR: ",
         trade.ResultRetcodeDescription()
      );
   }

   return result;
}

//+------------------------------------------------------------------+
//| Place SELL STOP                                                  |
//+------------------------------------------------------------------+
bool PlaceSellStop()
{
   if(!SpreadOK())
      return false;

   double bid =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_BID
      );

   double price =
      NormalizeDouble(
         bid - DistancePoints * _Point,
         _Digits
      );

   double sl =
      NormalizeDouble(
         price + StopLossPoints * _Point,
         _Digits
      );

   double tp =
      NormalizeDouble(
         price - TakeProfitPoints * _Point,
         _Digits
      );

   trade.SetExpertMagicNumber(MagicNumber);
   trade.SetDeviationInPoints(50);

   bool result =
      trade.SellStop(
         LotSize,
         price,
         _Symbol,
         sl,
         tp,
         ORDER_TIME_GTC,
         0,
         "REFRESH SELL STOP"
      );

   if(result)
   {
      Print(
         "NEW SELL STOP @ ",
         DoubleToString(price, _Digits)
      );
   }
   else
   {
      Print(
         "SELL STOP ERROR: ",
         trade.ResultRetcodeDescription()
      );
   }

   return result;
}

//+------------------------------------------------------------------+
//| Place NEW pair                                                   |
//+------------------------------------------------------------------+
void PlaceNewPair()
{
   // First delete ALL old pending orders
   DeletePendingOrders();

   // Then create fresh pair
   PlaceBuyStop();
   PlaceSellStop();
}

//+------------------------------------------------------------------+
//| Trailing stop                                                    |
//+------------------------------------------------------------------+
void ApplyTrailingStop()
{
   if(!UseTrailingStop)
      return;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket =
         PositionGetTicket(i);

      if(ticket == 0)
         continue;

      if(
         PositionGetString(POSITION_SYMBOL)
         != _Symbol
      )
         continue;

      if(
         (ulong)PositionGetInteger(
            POSITION_MAGIC
         ) != MagicNumber
      )
         continue;

      long type =
         PositionGetInteger(
            POSITION_TYPE
         );

      double currentSL =
         PositionGetDouble(
            POSITION_SL
         );

      double currentTP =
         PositionGetDouble(
            POSITION_TP
         );

      double openPrice =
         PositionGetDouble(
            POSITION_PRICE_OPEN
         );

      // BUY
      if(type == POSITION_TYPE_BUY)
      {
         double bid =
            SymbolInfoDouble(
               _Symbol,
               SYMBOL_BID
            );

         if(
            bid - openPrice >
            TrailingStopPoints * _Point
         )
         {
            double newSL =
               NormalizeDouble(
                  bid -
                  TrailingStopPoints * _Point,
                  _Digits
               );

            if(
               currentSL == 0 ||
               newSL > currentSL
            )
            {
               trade.PositionModify(
                  ticket,
                  newSL,
                  currentTP
               );
            }
         }
      }

      // SELL
      if(type == POSITION_TYPE_SELL)
      {
         double ask =
            SymbolInfoDouble(
               _Symbol,
               SYMBOL_ASK
            );

         if(
            openPrice - ask >
            TrailingStopPoints * _Point
         )
         {
            double newSL =
               NormalizeDouble(
                  ask +
                  TrailingStopPoints * _Point,
                  _Digits
               );

            if(
               currentSL == 0 ||
               newSL < currentSL
            )
            {
               trade.PositionModify(
                  ticket,
                  newSL,
                  currentTP
               );
            }
         }
      }
   }
}

//+------------------------------------------------------------------+
//| INITIALIZATION                                                   |
//+------------------------------------------------------------------+
int OnInit()
{
   trade.SetExpertMagicNumber(MagicNumber);
   trade.SetDeviationInPoints(50);

   Print(
      "========================================"
   );

   Print(
      "XAUUSD VOLUME BREAKOUT REFRESH EA"
   );

   Print(
      "BUY STOP + SELL STOP"
   );

   Print(
      "Every activation:"
   );

   Print(
      "DELETE OLD PENDING -> CREATE NEW PAIR"
   );

   Print(
      "========================================"
   );

   return(INIT_SUCCEEDED);
}

//+------------------------------------------------------------------+
//| MAIN                                                             |
//+------------------------------------------------------------------+
void OnTick()
{
   ApplyTrailingStop();

   //===============================================================
   // If absolutely nothing exists, wait for initial confirmation
   //===============================================================

   int positions =
      CountOpenPositions();

   int pending =
      CountPendingOrders();

   if(
      positions == 0 &&
      pending == 0
   )
   {
      if(!SpreadOK())
         return;

      if(!VolumeConfirmed())
         return;

      if(!BreakoutConfirmed())
         return;

      PlaceNewPair();
   }
}

//+------------------------------------------------------------------+
//| DETECT PENDING ACTIVATION                                        |
//+------------------------------------------------------------------+
void OnTradeTransaction(
   const MqlTradeTransaction &trans,
   const MqlTradeRequest &request,
   const MqlTradeResult &result
)
{
   if(
      trans.type !=
      TRADE_TRANSACTION_DEAL_ADD
   )
   {
      return;
   }

   if(trans.symbol != _Symbol)
      return;

   ulong deal =
      trans.deal;

   if(deal == 0)
      return;

   if(!HistoryDealSelect(deal))
      return;

   // Check magic
   ulong magic =
      (ulong)HistoryDealGetInteger(
         deal,
         DEAL_MAGIC
      );

   if(magic != MagicNumber)
      return;

   // Only new positions
   long entry =
      HistoryDealGetInteger(
         deal,
         DEAL_ENTRY
      );

   if(entry != DEAL_ENTRY_IN)
      return;

   long type =
      HistoryDealGetInteger(
         deal,
         DEAL_TYPE
      );

   double price =
      HistoryDealGetDouble(
         deal,
         DEAL_PRICE
      );

   //===============================================================
   // BUY STOP ACTIVATED
   //===============================================================

   if(type == DEAL_TYPE_BUY)
   {
      Print(
         "BUY STOP ACTIVATED @ ",
         DoubleToString(price, _Digits)
      );

      // Delete old pending
      DeletePendingOrders();

      // Immediately create new pair
      PlaceBuyStop();
      PlaceSellStop();

      Print(
         "NEW BUY STOP + SELL STOP CREATED"
      );

      return;
   }

   //===============================================================
   // SELL STOP ACTIVATED
   //===============================================================

   if(type == DEAL_TYPE_SELL)
   {
      Print(
         "SELL STOP ACTIVATED @ ",
         DoubleToString(price, _Digits)
      );

      // Delete old pending
      DeletePendingOrders();

      // Immediately create new pair
      PlaceBuyStop();
      PlaceSellStop();

      Print(
         "NEW BUY STOP + SELL STOP CREATED"
      );

      return;
   }
}

