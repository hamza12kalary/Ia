#property strict

#include <Trade/Trade.mqh>

CTrade trade;

input double LotSize = 0.01;
input double RiskReward = 2.0;

input int StopLossPoints = 300;

input bool UseBreakEven = true;
input double BreakEvenAtR = 1.0;

input int MagicNumber = 20260825;

datetime LastBar = 0;

//+------------------------------------------------------------------+
//| INIT                                                             |
//+------------------------------------------------------------------+
int OnInit()
{
   trade.SetExpertMagicNumber(MagicNumber);
   trade.SetDeviationInPoints(20);

   Print("XAUUSD.m EA + BREAK EVEN STARTED");

   return(INIT_SUCCEEDED);
}

//+------------------------------------------------------------------+
//| TICK                                                             |
//+------------------------------------------------------------------+
void OnTick()
{
   // Manage existing trade every tick
   if(UseBreakEven)
      ManageBreakEven();

   // New candle check
   datetime CurrentBar =
      iTime(_Symbol, PERIOD_M1, 0);

   if(CurrentBar == LastBar)
      return;

   LastBar = CurrentBar;

   if(HasPosition())
      return;

   CheckSignal();
}

//+------------------------------------------------------------------+
//| SIGNAL                                                           |
//+------------------------------------------------------------------+
void CheckSignal()
{
   double Open1 =
      iOpen(_Symbol, PERIOD_M1, 1);

   double Close1 =
      iClose(_Symbol, PERIOD_M1, 1);

   double Open2 =
      iOpen(_Symbol, PERIOD_M1, 2);

   double Close2 =
      iClose(_Symbol, PERIOD_M1, 2);

   // BUY
   if(Close2 < Open2 &&
      Close1 > Open1 &&
      Open1 <= Close2 &&
      Close1 >= Open2)
   {
      BuyTrade();
      return;
   }

   // SELL
   if(Close2 > Open2 &&
      Close1 < Open1 &&
      Open1 >= Close2 &&
      Close1 <= Open2)
   {
      SellTrade();
      return;
   }
}

//+------------------------------------------------------------------+
//| BUY                                                              |
//+------------------------------------------------------------------+
void BuyTrade()
{
   double Ask =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_ASK
      );

   double PointValue =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_POINT
      );

   int DigitsValue =
      (int)SymbolInfoInteger(
         _Symbol,
         SYMBOL_DIGITS
      );

   double SL =
      Ask -
      StopLossPoints * PointValue;

   double TP =
      Ask +
      StopLossPoints *
      RiskReward *
      PointValue;

   SL =
      NormalizeDouble(
         SL,
         DigitsValue
      );

   TP =
      NormalizeDouble(
         TP,
         DigitsValue
      );

   if(trade.Buy(
      LotSize,
      _Symbol,
      0.0,
      SL,
      TP,
      "BE BUY"))
   {
      Print(
         "BUY OPENED | Entry=",
         Ask,
         " SL=",
         SL,
         " TP=",
         TP
      );
   }
   else
   {
      Print(
         "BUY ERROR: ",
         trade.ResultRetcodeDescription()
      );
   }
}

//+------------------------------------------------------------------+
//| SELL                                                             |
//+------------------------------------------------------------------+
void SellTrade()
{
   double Bid =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_BID
      );

   double PointValue =
      SymbolInfoDouble(
         _Symbol,
         SYMBOL_POINT
      );

   int DigitsValue =
      (int)SymbolInfoInteger(
         _Symbol,
         SYMBOL_DIGITS
      );

   double SL =
      Bid +
      StopLossPoints * PointValue;

   double TP =
      Bid -
      StopLossPoints *
      RiskReward *
      PointValue;

   SL =
      NormalizeDouble(
         SL,
         DigitsValue
      );

   TP =
      NormalizeDouble(
         TP,
         DigitsValue
      );

   if(trade.Sell(
      LotSize,
      _Symbol,
      0.0,
      SL,
      TP,
      "BE SELL"))
   {
      Print(
         "SELL OPENED | Entry=",
         Bid,
         " SL=",
         SL,
         " TP=",
         TP
      );
   }
   else
   {
      Print(
         "SELL ERROR: ",
         trade.ResultRetcodeDescription()
      );
   }
}

//+------------------------------------------------------------------+
//| BREAK EVEN                                                       |
//+------------------------------------------------------------------+
void ManageBreakEven()
{
   for(int i = PositionsTotal() - 1;
       i >= 0;
       i--)
   {
      ulong Ticket =
         PositionGetTicket(i);

      if(Ticket == 0)
         continue;

      string SymbolName =
         PositionGetString(
            POSITION_SYMBOL
         );

      long Magic =
         PositionGetInteger(
            POSITION_MAGIC
         );

      if(SymbolName != _Symbol ||
         Magic != MagicNumber)
         continue;

      double Entry =
         PositionGetDouble(
            POSITION_PRICE_OPEN
         );

      double SL =
         PositionGetDouble(
            POSITION_SL
         );

      double TP =
         PositionGetDouble(
            POSITION_TP
         );

      long Type =
         PositionGetInteger(
            POSITION_TYPE
         );

      double CurrentPrice;

      // BUY
      if(Type == POSITION_TYPE_BUY)
      {
         CurrentPrice =
            SymbolInfoDouble(
               _Symbol,
               SYMBOL_BID
            );

         double Risk =
            Entry - SL;

         if(Risk <= 0)
            continue;

         double Trigger =
            Entry +
            Risk * BreakEvenAtR;

         // Move SL to Entry
         if(CurrentPrice >= Trigger &&
            SL < Entry)
         {
            int DigitsValue =
               (int)SymbolInfoInteger(
                  _Symbol,
                  SYMBOL_DIGITS
               );

            double NewSL =
               NormalizeDouble(
                  Entry,
                  DigitsValue
               );

            if(trade.PositionModify(
               Ticket,
               NewSL,
               TP))
            {
               Print(
                  "BUY BREAK-EVEN activated | SL -> Entry"
               );
            }
         }
      }

      // SELL
      if(Type == POSITION_TYPE_SELL)
      {
         CurrentPrice =
            SymbolInfoDouble(
               _Symbol,
               SYMBOL_ASK
            );

         double Risk =
            SL - Entry;

         if(Risk <= 0)
            continue;

         double Trigger =
            Entry -
            Risk * BreakEvenAtR;

         // Move SL to Entry
         if(CurrentPrice <= Trigger &&
            SL > Entry)
         {
            int DigitsValue =
               (int)SymbolInfoInteger(
                  _Symbol,
                  SYMBOL_DIGITS
               );

            double NewSL =
               NormalizeDouble(
                  Entry,
                  DigitsValue
               );

            if(trade.PositionModify(
               Ticket,
               NewSL,
               TP))
            {
               Print(
                  "SELL BREAK-EVEN activated | SL -> Entry"
               );
            }
         }
      }
   }
}

//+------------------------------------------------------------------+
//| CHECK POSITION                                                   |
//+------------------------------------------------------------------+
bool HasPosition()
{
   for(int i = PositionsTotal() - 1;
       i >= 0;
       i--)
   {
      ulong Ticket =
         PositionGetTicket(i);

      if(Ticket == 0)
         continue;

      string SymbolName =
         PositionGetString(
            POSITION_SYMBOL
         );

      long Magic =
         PositionGetInteger(
            POSITION_MAGIC
         );

      if(SymbolName == _Symbol &&
         Magic == MagicNumber)
      {
         return true;
      }
   }

   return false;
}
